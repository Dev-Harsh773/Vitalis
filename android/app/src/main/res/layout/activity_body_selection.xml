<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vitalis_surface"
    tools:context=".BodySelectionActivity">

    <!-- Top AppBar -->
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="64.5dp"
        android:background="#FAFBFF"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="24dp">
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_vitalis_logo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/ivLogo"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="Vitalis"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/vitalis_primary" />
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/vitalis_on_surface_variant" />
        </RelativeLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Where are you feeling symptoms?"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/vitalis_primary"
                android:lineHeight="40dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select an area on the clinical map to find specialized practitioners and immediate care options tailored to your needs."
                android:textSize="14sp"
                android:textColor="@color/vitalis_on_surface_variant"
                android:layout_marginBottom="32dp" />

            <!-- Quick Selection Grid (2x2) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginBottom="40dp">
                
                <!-- Eye Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F3F5F9">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/vitalis_secondary"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EYE"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/vitalis_on_surface" />
                        <Button
                            android:id="@+id/btnQuickEye"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:stateListAnimator="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Nose Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F3F5F9">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/vitalis_secondary"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NOSE"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/vitalis_on_surface" />
                        <Button
                            android:id="@+id/btnQuickNose"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:stateListAnimator="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Mouth Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F3F5F9">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/vitalis_secondary"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOUTH"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/vitalis_on_surface" />
                        <Button
                            android:id="@+id/btnQuickMouth"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:stateListAnimator="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Neck Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F3F5F9">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/vitalis_secondary"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NECK"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/vitalis_on_surface" />
                        <Button
                            android:id="@+id/btnQuickNeck"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:stateListAnimator="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>

            <!-- Anatomical Map Frame -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="40dp"
                app:cardElevation="0.5dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="48dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="40dp"
                    android:paddingHorizontal="20dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/bodyMapContainer"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        
                        <!-- Core Body Components (Btn IDs preserved) -->
                        <Button android:id="@+id/btnHead" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_quiet_input" android:text="HEAD" android:textSize="10sp" android:textColor="@color/vitalis_secondary" android:stateListAnimator="@null" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
                        <LinearLayout android:id="@+id/layFace" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintTop_toBottomOf="@id/btnHead" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"><Button android:id="@+id/btnEye" android:layout_width="40dp" android:layout_height="24dp" android:text="EYE" android:textSize="8sp" android:background="@android:color/transparent" /><Button android:id="@+id/btnNose" android:layout_width="40dp" android:layout_height="24dp" android:text="NOSE" android:textSize="8sp" android:background="@android:color/transparent" /><Button android:id="@+id/btnMouth" android:layout_width="40dp" android:layout_height="24dp" android:text="MOUTH" android:textSize="8sp" android:background="@android:color/transparent" /></LinearLayout>
                        <Button android:id="@+id/btnNeck" android:layout_width="40dp" android:layout_height="16dp" android:background="@drawable/bg_quiet_input" android:stateListAnimator="@null" app:layout_constraintTop_toBottomOf="@id/layFace" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="2dp" />
                        <Button android:id="@+id/btnChest" android:layout_width="100dp" android:layout_height="60dp" android:background="@drawable/bg_gradient_button" android:text="CHEST" android:textColor="@color/white" android:textStyle="bold" android:textSize="11sp" android:stateListAnimator="@null" app:layout_constraintTop_toBottomOf="@id/btnNeck" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="4dp" />
                        <Button android:id="@+id/btnLeftArm" android:layout_width="40dp" android:layout_height="100dp" android:background="@drawable/bg_quiet_input" android:text="ARM" android:textSize="10sp" android:textColor="@color/vitalis_primary" android:stateListAnimator="@null" app:layout_constraintTop_toTopOf="@id/btnChest" app:layout_constraintEnd_toStartOf="@+id/btnChest" android:layout_marginEnd="4dp" />
                        <Button android:id="@+id/btnRightArm" android:layout_width="40dp" android:layout_height="100dp" android:background="@drawable/bg_quiet_input" android:text="ARM" android:textSize="10sp" android:textColor="@color/vitalis_primary" android:stateListAnimator="@null" app:layout_constraintTop_toTopOf="@id/btnChest" app:layout_constraintStart_toEndOf="@+id/btnChest" android:layout_marginStart="4dp" />
                        <Button android:id="@+id/btnAbdomen" android:layout_width="100dp" android:layout_height="60dp" android:background="@drawable/bg_quiet_input" android:text="ABDOMEN" android:textSize="11sp" android:textColor="@color/vitalis_on_surface" android:stateListAnimator="@null" app:layout_constraintTop_toBottomOf="@id/btnChest" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="4dp" />
                        <Button android:id="@+id/btnPrivatePart" android:layout_width="60dp" android:layout_height="32dp" android:background="@drawable/bg_quiet_input" android:stateListAnimator="@null" app:layout_constraintTop_toBottomOf="@id/btnAbdomen" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="4dp" />
                        <Button android:id="@+id/btnLeftLeg" android:layout_width="46dp" android:layout_height="120dp" android:background="@drawable/bg_quiet_input" android:text="LEG" android:textSize="10sp" android:textColor="@color/vitalis_primary" android:stateListAnimator="@null" app:layout_constraintTop_toBottomOf="@id/btnPrivatePart" app:layout_constraintEnd_toStartOf="@+id/guidelineBody" android:layout_marginEnd="2dp" android:layout_marginTop="4dp" />
                        <Button android:id="@+id/btnRightLeg" android:layout_width="46dp" android:layout_height="120dp" android:background="@drawable/bg_quiet_input" android:text="LEG" android:textSize="10sp" android:textColor="@color/vitalis_primary" android:stateListAnimator="@null" app:layout_constraintTop_toBottomOf="@id/btnPrivatePart" app:layout_constraintStart_toEndOf="@+id/guidelineBody" android:layout_marginStart="2dp" android:layout_marginTop="4dp" />
                        <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.5" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- CTA Find Doctors for specific part (Preserved ID logic) -->
                    <FrameLayout
                        android:id="@+id/btnFindDoctorsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="32dp"
                        app:layout_constraintTop_toBottomOf="@id/bodyMapContainer">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gradient_button" />
                        <TextView
                            android:id="@+id/tvCtaText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Find Doctors for Selection →"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                        <Button
                            android:id="@+id/btnFindDoctors"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:stateListAnimator="@null" />
                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Top Specialists Nearby List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top Specialists Nearby"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/vitalis_on_surface" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="View All"
                        android:textColor="@color/vitalis_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </RelativeLayout>
                
                <LinearLayout
                    android:id="@+id/layDoctorsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Empty State -->
                <TextView
                    android:id="@+id/tvEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:text="Select a body part on the map above to see recommended specialists."
                    android:gravity="center"
                    android:textColor="@color/vitalis_on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Logout Session"
                android:textColor="@color/vitalis_error"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:layout_marginTop="32dp" />

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
