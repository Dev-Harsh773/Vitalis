<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vitalis_surface"
    tools:context=".SlotCreationActivity">

    <!-- Header Section -->
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="24dp">
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_vitalis_logo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/ivLogo"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="Schedule Availability"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/vitalis_primary" />
        </RelativeLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/btnSaveAllContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Define Clinical Hours"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/vitalis_on_surface"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Specify the time ranges when you are available for consultations."
                android:textSize="14sp"
                android:textColor="@color/vitalis_on_surface_variant"
                android:layout_marginBottom="32dp" />

            <!-- Time Input Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="START TIME"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/vitalis_primary"
                        android:layout_marginBottom="6dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_quiet_input"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">
                        <EditText
                            android:id="@+id/etStartTime"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:hint="09:00"
                            android:inputType="time"
                            android:textSize="16sp"
                            android:textColor="@color/vitalis_on_surface" />
                        <Spinner
                            android:id="@+id/spinStartAmPm"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="END TIME"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/vitalis_primary"
                        android:layout_marginBottom="6dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_quiet_input"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">
                        <EditText
                            android:id="@+id/etEndTime"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:hint="11:30"
                            android:inputType="time"
                            android:textSize="16sp"
                            android:textColor="@color/vitalis_on_surface" />
                        <Spinner
                            android:id="@+id/spinEndAmPm"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Enter Slot Button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="32dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_quiet_input" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+ ADD TO PENDING LIST"
                    android:textColor="@color/vitalis_primary"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/btnEnterSlot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pending Slots"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/vitalis_on_surface"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/layTimesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:minHeight="100dp" />
            </androidx.cardview.widget.CardView>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISCARD &amp; RETURN TO DASHBOARD"
                    android:textColor="@color/vitalis_error"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:padding="24dp"
                    android:alpha="0.6"/>
                <Button
                    android:id="@+id/btnGoToDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@null" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Save All Button -->
    <FrameLayout
        android:id="@+id/btnSaveAllContainer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gradient_button" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="SAVE ALL SLOTS TO DATABASE"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.1" />
        <Button
            android:id="@+id/btnSaveAll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
