<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vitalis_surface"
    tools:context=".MainActivity">

    <!-- Background Decorative Elements -->
    <View
        android:id="@+id/viewDecorTop"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp"
        android:alpha="0.2"
        android:background="@drawable/bg_gradient_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_vitalis_logo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/ivLogo"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="Vitalis"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/vitalis_primary" />
        </RelativeLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vitalis Role Selection"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/vitalis_on_surface"
                android:gravity="center"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome back. Please select your account type to access your personalized medical portal."
                android:textSize="16sp"
                android:textColor="@color/vitalis_on_surface_variant"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="40dp"/>

            <!-- Doctor Tile -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnDoctorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/white">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:gravity="center_horizontal">

                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_gradient_button"
                            android:padding="20dp"
                            android:layout_marginBottom="16dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_doctor"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Doctor"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/vitalis_on_surface"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Manage patient records, schedule consultations, and oversee medical diagnostics."
                            android:textSize="14sp"
                            android:textColor="@color/vitalis_on_surface_variant"
                            android:gravity="center"
                            android:layout_marginBottom="16dp"/>

                        <!-- Visual Button -->
                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Access Portal"
                            android:textColor="@color/vitalis_primary"
                            android:background="@android:color/transparent"
                            android:stateListAnimator="@null"
                            android:clickable="false"
                            android:focusable="false"/>

                    </LinearLayout>

                    <!-- Transparent Button to satisfy Java findViewById<Button>(R.id.btnDoctor) -->
                    <Button
                        android:id="@+id/btnDoctor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:stateListAnimator="@null" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Patient Tile -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnPatientCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/white">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:gravity="center_horizontal">

                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@color/vitalis_secondary_container"
                            android:padding="20dp"
                            android:layout_marginBottom="16dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_patient"
                                app:tint="@color/vitalis_secondary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Patient"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/vitalis_on_surface"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="View health records, book appointments, and connect with your healthcare providers."
                            android:textSize="14sp"
                            android:textColor="@color/vitalis_on_surface_variant"
                            android:gravity="center"
                            android:layout_marginBottom="16dp"/>

                        <!-- Visual Button -->
                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Access Health Space"
                            android:textColor="@color/vitalis_secondary"
                            android:background="@android:color/transparent"
                            android:stateListAnimator="@null"
                            android:clickable="false"
                            android:focusable="false"/>

                    </LinearLayout>

                    <!-- Transparent Button to satisfy Java findViewById<Button>(R.id.btnPatient) -->
                    <Button
                        android:id="@+id/btnPatient"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:stateListAnimator="@null" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_quiet_input"
            android:gravity="center">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_vitalis_logo"
                app:tint="@color/vitalis_secondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="SECURE AUTO-LOGIN ENABLED"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/vitalis_on_surface_variant"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vitalis Clinical Sanctuary © 2024"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:alpha="0.4"
            android:layout_marginTop="24dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
