<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vitalis_surface"
    tools:context=".RegisterActivity">

    <!-- Decorative Top Element -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_gradient_button"
        android:alpha="0.05"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_vitalis_logo"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvRegisterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join Vitalis"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/vitalis_on_surface"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create your clinical profile to begin"
                android:textSize="14sp"
                android:textColor="@color/vitalis_on_surface_variant"
                android:gravity="center"
                android:layout_marginBottom="40dp"/>

            <!-- Name Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FULL NAME"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/vitalis_primary"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_quiet_input"
                android:layout_marginBottom="16dp"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:id="@+id/ivNameIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_person"
                    android:layout_centerVertical="true"
                    app:tint="@color/vitalis_on_surface_variant" />
                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/ivNameIcon"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    android:textSize="15sp"
                    android:textColor="@color/vitalis_on_surface"
                    android:textColorHint="@color/vitalis_outline" />
            </RelativeLayout>

            <!-- Email Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EMAIL ADDRESS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/vitalis_primary"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_quiet_input"
                android:layout_marginBottom="16dp"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:id="@+id/ivEmailIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_email"
                    android:layout_centerVertical="true"
                    app:tint="@color/vitalis_on_surface_variant" />
                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/ivEmailIcon"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:hint="name@example.com"
                    android:inputType="textEmailAddress"
                    android:textSize="15sp"
                    android:textColor="@color/vitalis_on_surface"
                    android:textColorHint="@color/vitalis_outline" />
            </RelativeLayout>

            <!-- Password Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PASSWORD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/vitalis_primary"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_quiet_input"
                android:layout_marginBottom="24dp"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:id="@+id/ivLockIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock"
                    android:layout_centerVertical="true"
                    app:tint="@color/vitalis_on_surface_variant" />
                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/ivLockIcon"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:hint="Create a password"
                    android:inputType="textPassword"
                    android:textSize="15sp"
                    android:textColor="@color/vitalis_on_surface"
                    android:textColorHint="@color/vitalis_outline" />
            </RelativeLayout>

            <!-- Confirm Password Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONFIRM PASSWORD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/vitalis_primary"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_quiet_input"
                android:layout_marginBottom="24dp"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:id="@+id/ivConfirmIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock"
                    android:layout_centerVertical="true"
                    app:tint="@color/vitalis_on_surface_variant" />
                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/ivConfirmIcon"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:hint="Re-type your password"
                    android:inputType="textPassword"
                    android:textSize="15sp"
                    android:textColor="@color/vitalis_on_surface"
                    android:textColorHint="@color/vitalis_outline" />
            </RelativeLayout>

            <!-- Role Dependent: Specialization -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/spinnerSpecialization"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:visibility="gone"
                    android:background="@drawable/bg_quiet_input"
                    android:layout_marginBottom="24dp"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>

            <!-- Role Dependent: Map Location Button -->
            <Button
                android:id="@+id/btnLocation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:visibility="gone"
                android:layout_marginBottom="32dp"
                android:text="Set Practice Location on Map"
                android:background="@drawable/bg_quiet_input"
                android:textColor="@color/vitalis_on_surface"
                android:textSize="14sp"
                android:stateListAnimator="@null"
                android:gravity="center" />

            <!-- Gradient Registration Button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="24dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gradient_button" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="CREATE ACCOUNT"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:letterSpacing="0.1" />

                <!-- Transparent Button to satisfy Java cast -->
                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@null" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
